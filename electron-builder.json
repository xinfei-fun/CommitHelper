{
  "appId": "com.baker_kong.commit_helper",
  "productName": "Commit Helper",
  "directories": {
    "output": "dist/app"
  },
  "files": [
    "dist/web/**/*",
    "src/main/index.js",
    "src/preload/index.js",
    "node_modules/**/*",
    "hooks/**/*",
    "scripts/**/*",
    "bin/**/*",
    "commit-helper.json"
  ],
  "extraMetadata": {
    "main": "src/main/index.js"
  },
  "win": {
    "target": "portable",
    "icon": "assets/icon.ico",
    "artifactName": "commit-helper.exe"
  },
  "mac": {
    "target": {
      "target": "dmg",
      "arch": ["arm64", "x64"]
    },
    "icon": "assets/icon.icns"
  },
  "linux": {
    "target": "AppImage",
    "icon": "assets/icon.png"
  }
}
